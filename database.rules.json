{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "$uid === auth.uid || root.child('users/' + auth.uid + '/children/' + $uid).exists()",
        ".write": "$uid === auth.uid"
      }
    },
    "calls": {
      "$childUid": {
        ".read":  "root.child('users/' + auth.uid + '/children/' + $childUid).exists() || auth.uid === $childUid",
