{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "auth != null && ($uid === auth.uid || root.child('users/' + auth.uid + '/children/' + $uid).exists())",
        ".write": "auth != null && $uid === auth.uid",
        "pendingParentRequests": {
          "$parentUid": {
            ".write": "auth != null && auth.uid === $parentUid",
            ".read":  "auth != null && auth.uid === $uid"
          }
        },
        "approvedParents": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "children": {
          "$childUid": {
            ".read":  "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "calls": {
      "$childUid": {
        ".read":  "auth != null && (root.child('users/' + auth.uid + '/children/' + $childUid).exists() || auth.uid === $childUid)",
        ".write": "auth != null && (root.child('users/' + auth.uid + '/children/' + $childUid).exists() || auth.uid === $childUid)"
      }
    },
    "sessions": {
      "$childUid": {
        "$parentUid": {
          ".read":  "auth != null && (auth.uid === $childUid || auth.uid === $parentUid)",
          ".write": "auth != null && (auth.uid === $childUid || auth.uid === $parentUid)"
        }
      }
    },
    "commands": {
      "$childUid": {
        ".read":  "auth != null && auth.uid === $childUid",
