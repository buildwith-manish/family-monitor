{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",

        "isOnline": { ".read": "auth != null" },
        "childName": { ".read": "auth != null" },
        "deviceName": { ".read": "auth != null" },

        "location": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid"
        },

        "pendingParentRequests": {
          "$parentUid": {
            ".write": "auth != null && auth.uid == $parentUid",
            ".read": "auth != null && auth.uid == $uid"
          }
        },

        "approvedParents": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        },

        "children": {
          "$childUid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null"
          }
        }
      }
    },

    "sessions": {
      "$childUid": {
        "$parentUid": {
          ".read": "auth != null && (auth.uid == $childUid || auth.uid == $parentUid)",
          ".write": "auth != null && (auth.uid == $childUid || auth.uid == $parentUid)"
        }
      }
    },

    "commands": {
      "$childUid": {
        "$parentUid": {
          ".read": "auth != null && auth.uid == $childUid",
          ".write": "auth != null && (auth.uid == $parentUid || auth.uid == $childUid)"
        },
        "lock": {
          ".read": "auth != null && auth.uid == $childUid",
          ".write": "auth != null"
        },
        "snapshot": {
          ".read": "auth != null && auth.uid == $childUid",
          ".write": "auth != null"
        },
        "syncCallLog": {
          ".read": "auth != null && auth.uid == $childUid",
          ".write": "auth != null"
        },
        "syncContacts": {
          ".read": "auth != null && auth.uid == $childUid",
          ".write": "auth != null"
        }
      }
    },

    "screen_time": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $childUid"
      }
    },

    "screen_time_limits": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "call_logs": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $childUid"
      }
    },

    "contacts": {
      "$childUid": {
        "all": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $childUid"
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "content_filter": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "geofences": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "snapshots": {
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $childUid"
      }
    },

    "alerts": {
      "$parentUid": {
        ".read": "auth != null && auth.uid == $parentUid",
        "sos": {
          ".write": "auth != null"
        },
        "geofence": {
          ".write": "auth != null"
        }
      }
    }
  }
}
